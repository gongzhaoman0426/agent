generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ better-auth ============

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  emailVerified       Boolean               @default(false)
  name                String
  image               String?
  username            String                @unique
  displayUsername     String?
  accounts            Account[]
  sessions            Session[]
  userToolkitSettings UserToolkitSettings[]
  skills              Skill[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("users")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============ Agent ============

model Agent {
  id             String          @id @default(cuid())
  name           String
  description    String?
  prompt         String
  model          String?
  createdById    String?
  deleted        Boolean         @default(false)
  agentToolkits  AgentToolkit[]
  agentWorkflows AgentWorkflow[]
  agentSkills    AgentSkill[]
  /** 挂载在本智能体上的子智能体 */
  subAgents      AgentSubAgent[] @relation("SubAgentParent")
  /** 本智能体被哪些智能体挂载 */
  parentAgents   AgentSubAgent[] @relation("SubAgentChild")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([createdById, deleted])
  @@map("agents")
}

// 智能体互挂：子智能体作为父智能体的一个工具
model AgentSubAgent {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  parent    Agent    @relation("SubAgentParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Agent    @relation("SubAgentChild", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([childId])
  @@map("agent_sub_agents")
}

// ============ Toolkit 注册表（代码发现同步） ============

model Toolkit {
  id                  String                @id
  name                String
  description         String
  /** SettingField[]：用户级配置字段声明，前端据此渲染表单 */
  settingsFields      Json?
  deleted             Boolean               @default(false)
  tools               Tool[]
  agentToolkits       AgentToolkit[]
  userToolkitSettings UserToolkitSettings[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("toolkits")
}

model Tool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  inputSchema Json?
  toolkitId   String
  toolkit     Toolkit  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tools")
}

// ============ Workflow 注册表（代码发现同步，仅元数据） ============

model Workflow {
  id             String          @id
  name           String
  description    String
  inputSchema    Json?
  deleted        Boolean         @default(false)
  agentWorkflows AgentWorkflow[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("workflows")
}

// ============ 挂载关系 ============

model AgentToolkit {
  id        String   @id @default(cuid())
  agentId   String
  toolkitId String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolkit   Toolkit  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([agentId, toolkitId])
  @@map("agent_toolkits")
}

model AgentWorkflow {
  id         String   @id @default(cuid())
  agentId    String
  workflowId String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([agentId, workflowId])
  @@map("agent_workflows")
}

// ============ Skill（用户上传的技能包，文件存 data/skills，元数据入库） ============

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /** 相对 data/skills 的存储目录（<ownerId>/<name>） */
  dirPath     String
  scripts     Json     @default("[]")
  references  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, name])
  @@map("skills")
}

// 挂载关系按 skill name 引用（同一 owner 下唯一）
model AgentSkill {
  id        String   @id @default(cuid())
  agentId   String
  skillName String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([agentId, skillName])
  @@map("agent_skills")
}

// ============ 用户级工具配置 ============

model UserToolkitSettings {
  id        String   @id @default(cuid())
  userId    String
  toolkitId String
  settings  Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolkit   Toolkit  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toolkitId])
  @@map("user_toolkit_settings")
}

// ============ 定时任务（到期后模拟用户对 Agent 说一句话） ============

model ScheduledTask {
  id          String    @id @default(cuid())
  userId      String
  agentId     String
  /** 到期时发给 Agent 的用户消息 */
  message     String
  /** 创建渠道：web / wechat …；结果回传同一渠道 */
  channel     String
  /** 渠道附加信息（如未来微信 openId），可选 */
  channelMeta Json?
  /** 该用户+Agent 固定复用的定时任务会话 ID */
  sessionId   String
  runAt       DateTime
  /** pending | running | completed | failed | cancelled */
  status      String    @default("pending")
  resultText  String?
  errorMessage String?
  /** 渠道侧已消费结果的时间；web 由前端 ack */
  deliveredAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([userId, status, deliveredAt])
  @@index([userId, agentId, status])
  @@map("scheduled_tasks")
}
