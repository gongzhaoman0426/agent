# PostgreSQL (docker compose up -d 启动的 pgvector 实例)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/agent_next

PORT=3003

# 模型 API（Mastra model router）
OPENAI_API_KEY=
OPENAI_BASE_URL=
MASTRA_DEFAULT_MODEL=openai/gpt-5.6-luna
MASTRA_EMBEDDING_MODEL=openai/text-embedding-3-small
# 会话标题生成模型（收尾阶段异步执行，不阻塞回复）
MASTRA_TITLE_MODEL=openai/gpt-5.6-luna
# 跨会话语义召回：开启后每轮提问和每条落库消息都要调 embedding 接口，明显更慢
MASTRA_SEMANTIC_RECALL=false

# better-auth
BETTER_AUTH_SECRET=agent-next-dev-secret
BETTER_AUTH_URL=http://localhost:3003
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5180
