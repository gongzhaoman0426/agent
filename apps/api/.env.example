# PostgreSQL (docker compose up -d 启动的 pgvector 实例)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/agent_next

PORT=3003

# 模型 API（Mastra model router）
# DeepSeek 官方（默认聊天模型 deepseek/deepseek-v4-flash）
DEEPSEEK_API_KEY=
MASTRA_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# 会话标题生成模型（收尾阶段异步执行，不阻塞回复）
MASTRA_TITLE_MODEL=deepseek/deepseek-v4-flash
# Observational Memory（长对话压缩；默认 true；勿用 true 裸开以免默认走 Gemini）
MASTRA_OBSERVATIONAL_MEMORY=true
MASTRA_OM_MODEL=deepseek/deepseek-v4-flash
# 跨会话语义召回（默认关闭；开启才需要 MASTRA_EMBEDDING_MODEL + OPENAI_API_KEY 等）
MASTRA_SEMANTIC_RECALL=false
# MASTRA_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# better-auth（生产写成 NPM 上的最终域名，如 https://agent.example.com）
BETTER_AUTH_SECRET=agent-next-dev-secret
BETTER_AUTH_URL=http://localhost:5180
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5180

# 微信个微协议（wechat-v875，文档 /docs/）
WECHAT_PAD_BASE_URL=http://127.0.0.1:8075
WECHAT_PAD_ADMIN_KEY=gucheng
# v875 服务器能访问到的本 API 根地址（用于 SetForward 推送入站消息）
# 例：http://38.55.194.196:3003 或 https://agent.example.com
# WECHAT_PAD_CALLBACK_BASE_URL=http://127.0.0.1:3003
# 语音工具：仅本机 TTS（macOS say / Linux espeak-ng）+ ffmpeg → silk
# macOS 音色：say -v '?' 可查看；默认 Tingting
# WECHAT_TTS_LOCAL_VOICE=Tingting
